---
import SectionHeader from './SectionHeader.astro';
import Button from './Button.astro';

const { data, shared = {}, email = 'contact@mohamedalimabrouki.com' } = Astro.props;
---

<section id="contact" class="section section--muted" data-section="contact">
  <div class="container contact">
    <div class="contact__intro">
      <SectionHeader title={data.title} intro={data.intro} align="left" />
      <ul class="contact__channels" data-reveal>
        {data.channels.map(channel => (
          <li>
            <span class="channel__label">{channel.label}</span>
            <a href={channel.href} rel={channel.href.startsWith('http') ? 'noopener' : undefined} target={channel.href.startsWith('http') ? '_blank' : undefined}>{channel.value}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="contact__form tilt-card" data-reveal data-no-tilt>
      <h3>{data.form.title}</h3>
      <p>{data.form.description}</p>
      <form
        id="contact-form"
        data-mailto={data.form.mailto}
        data-email={email}
        data-copied-message={shared.contact_copied || ''}
        data-fallback-message={shared.contact_fallback || ''}
      >
        {data.form.fields.map(field => (
          <label class="form-field">
            <span>{field.label}</span>
            {field.type === 'textarea' ? (
              <textarea name={field.id} id={`contact-${field.id}`} placeholder={field.placeholder} rows="5"></textarea>
            ) : (
              <input type={field.type} name={field.id} id={`contact-${field.id}`} placeholder={field.placeholder} autocomplete={field.id === 'email' ? 'email' : field.id === 'name' ? 'name' : undefined} />
            )}
          </label>
        ))}
        <p class="form-privacy">{data.form.privacy}</p>
        <Button type="submit" variant="primary">{data.form.cta_label}</Button>
        <p class="form-status" data-contact-status role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </div>
</section>
